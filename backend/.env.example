# Server Configuration
PROJECT_NAME="AI Career Guidance Backend"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
SECRET_KEY="super-secret-key-change-in-production-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL default, or sqlite+aiosqlite:///./career_guidance.db for local)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/career_guidance"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# AI Provider Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Firebase Production Credentials (Admin SDK)
FIREBASE_PROJECT_ID="careerai-app-9777b"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@careerai-app-9777b.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="careerai-app-9777b.firebasestorage.app"
FIREBASE_DATABASE_URL="https://careerai-app-9777b-default-rtdb.firebaseio.com"
# Alternatively, path to downloaded service account JSON file:
FIREBASE_CREDENTIALS_PATH="serviceAccountKey.json"


# Firebase Local Emulator Suite (Optional for offline dev)
USE_FIREBASE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"

