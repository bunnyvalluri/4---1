rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPER FUNCTIONS
    // ==========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    function isDocOwner() {
      return isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }

    function isCreatingSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================================
    // 1. USERS & PROFILES
    // ==========================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isCreatingSelf(userId);
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /education/{docId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /experiences/{docId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    // ==========================================================
    // 2. SKILLS & INTERESTS TAXONOMY
    // ==========================================================

    match /skills/{skillId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /user_skills/{docId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /interests/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /certifications/{docId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    // ==========================================================
    // 3. CAREERS & PROJECTS
    // ==========================================================

    match /careers/{careerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /career_skills/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================================
    // 4. ASSESSMENTS & QUESTIONS
    // ==========================================================

    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /assessment_attempts/{attemptId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /answers/{answerId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    // ==========================================================
    // 5. RECOMMENDATIONS & ROADMAPS
    // ==========================================================

    match /career_recommendations/{recId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /skill_gaps/{gapId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /roadmaps/{roadmapId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /roadmap_items/{itemId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    // ==========================================================
    // 6. RESUMES & ATS ANALYSES
    // ==========================================================

    match /resumes/{resumeId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /resume_analyses/{analysisId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    // ==========================================================
    // 7. CHAT ASSISTANT & NOTIFICATIONS
    // ==========================================================

    match /chat_sessions/{sessionId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /chat_messages/{messageId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    match /notifications/{notifId} {
      allow read, write: if (resource == null && request.resource.data.userId == request.auth.uid) || isDocOwner() || isAdmin();
    }

    // ==========================================================
    // 8. AUDIT LOGS
    // ==========================================================

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }
  }
}
